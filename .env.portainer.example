# =============================================================================
# Wakapi — environment template for the Portainer / Docker Swarm stack (stack.yml)
# =============================================================================
# Copy these into Portainer's "Environment variables" section when creating the
# stack (or use this file as a reference). Do NOT commit real secrets.
#
# Generate strong random values, e.g.:
#   openssl rand -hex 32
# =============================================================================

# ---- Image -------------------------------------------------------------------
# Published by the CI pipeline. Use a fixed tag in production (e.g. a release
# version or a sha-<short> tag) instead of a moving tag like "develop"/"latest".
# If the GHCR package is private, add the registry credentials in Portainer
# (Registries) — not here.
WAKAPI_IMAGE_REPO=ghcr.io/salesadriano/wakapi
WAKAPI_IMAGE_TAG=latest

# ---- Networking --------------------------------------------------------------
# External port published by the Swarm ingress mesh (host port -> container 3000).
# NOTE: this is NOT Wakapi's internal listen port (the container always listens
# on 3000); it is intentionally named differently to avoid a clash.
WAKAPI_PUBLISHED_PORT=3000

# Public URL used to build absolute links (e.g. password-reset e-mails). MUST
# match how users reach the instance (scheme + host + optional base path).
WAKAPI_PUBLIC_URL=https://wakapi.example.com
# Set if served under a sub-path behind a reverse proxy (otherwise keep "/").
WAKAPI_BASE_PATH=/

# ---- Required secrets (no defaults — deploy fails if unset) -------------------
WAKAPI_DB_PASSWORD=change_me_with_a_strong_password
# Pepper used when hashing user passwords. Changing it later invalidates all
# existing passwords, so set it once and keep it safe.
WAKAPI_PASSWORD_SALT=change_me_with_a_long_random_salt

# ---- Security ----------------------------------------------------------------
# Stable key so sessions / flash messages survive restarts and re-deploys.
# Leave empty for an ephemeral key (sessions reset on every restart).
WAKAPI_SESSION_KEY=change_me_with_a_long_random_key
# Keep "true" when a reverse proxy terminates TLS and talks plain HTTP to wakapi.
# Set "false" only if wakapi itself is reached directly over HTTPS.
WAKAPI_INSECURE_COOKIES=true
# Trust X-Forwarded-* headers from the proxy (correct client IPs for rate limits).
WAKAPI_ENABLE_PROXY=true

# ---- Database (Postgres service in the stack) --------------------------------
WAKAPI_DB_NAME=wakapi
WAKAPI_DB_USER=wakapi

# ---- Application toggles ------------------------------------------------------
WAKAPI_ALLOW_SIGNUP=true
WAKAPI_LEADERBOARD_ENABLED=true

# ---- Mail (optional) ---------------------------------------------------------
# Set WAKAPI_MAIL_ENABLED=true and fill the SMTP settings to enable e-mails
# (password reset, weekly reports, ...).
WAKAPI_MAIL_ENABLED=false
WAKAPI_MAIL_SENDER=Wakapi <noreply@example.com>
WAKAPI_MAIL_SMTP_HOST=
WAKAPI_MAIL_SMTP_PORT=587
WAKAPI_MAIL_SMTP_USER=
WAKAPI_MAIL_SMTP_PASS=
WAKAPI_MAIL_SMTP_TLS=true
